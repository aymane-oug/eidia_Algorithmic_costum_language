    <contexts>
      <context name="Normal" attribute="Normal Text" lineEndContext="#stay">
        <DetectSpaces/>
        <!-- Line comments -->
        <RegExpr attribute="Comment" context="CommentLine" String="//" />
        <!-- Block comments -->
        <StringDetect attribute="Comment" context="CommentBlock" String="/*" />
        <!-- Keywords BEFORE DetectIdentifier -->
        <keyword attribute="Keyword1" context="#stay" String="keywords1" />
        <keyword attribute="Keyword2" context="#stay" String="keywords2" />
        <keyword attribute="Keyword3" context="#stay" String="keywords3" />
        <keyword attribute="Keyword4" context="#stay" String="keywords4" />
        <keyword attribute="Keyword5" context="#stay" String="keywords5" />
        <keyword attribute="Keyword6" context="#stay" String="keywords6" />
        <keyword attribute="Keyword7" context="#stay" String="keywords7" />
        <!-- Consume identifiers LAST -->
        <DetectIdentifier/>
        <!-- Numbers -->
        <Float attribute="Number" context="#stay" />
        <Int attribute="Number" context="#stay" />
        <!-- Operators -->
        <AnyChar attribute="Operator" context="#stay" String="&lt;&gt;=&lt;&gt;=+-*/^&amp;:;,.()[]{}" />
        <DetectChar attribute="Operator" context="#stay" char="←" />
        <StringDetect attribute="Operator" context="#stay" String="&lt;--" />
        <StringDetect attribute="Operator" context="#stay" String="&lt;-" />
        <StringDetect attribute="Operator" context="#stay" String="!=" />
        <!-- Strings -->
        <DetectChar attribute="String" context="StringDQ" char="&quot;" />
        <DetectChar attribute="String" context="StringSQ" char="'" />
      </context>

      <context name="CommentLine" attribute="Comment" lineEndContext="#pop">
        <LineContinue attribute="Comment" context="#stay" />
      </context>

      <context name="CommentBlock" attribute="Comment" lineEndContext="#stay">
        <StringDetect attribute="Comment" context="#pop" String="*/" />
      </context>

      <context name="StringDQ" attribute="String" lineEndContext="#pop">
        <DetectChar attribute="String" context="#pop" char="&quot;" />
        <DetectChar attribute="String" context="#stay" char="\" />
      </context>

      <context name="StringSQ" attribute="String" lineEndContext="#pop">
        <DetectChar attribute="String" context="#pop" char="'" />
        <DetectChar attribute="String" context="#stay" char="\" />
      </context>
    </contexts>

